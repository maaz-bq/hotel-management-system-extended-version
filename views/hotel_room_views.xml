<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_room_view_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Physical Rooms">
                <field name="name" string="Room Number"/>
                <field name="room_type_id"/>
                <field name="hotel_id"/>
                <field name="floor" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="hotel_room_view_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Physical Room">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. 201"/>
                            <field name="room_type_id" options="{'no_create': True}"/>
                            <field name="hotel_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="floor"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Internal notes about this room..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_room_view_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search string="Physical Rooms">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="hotel_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Room Type" name="group_room_type"
                        context="{'group_by': 'room_type_id'}"/>
                    <filter string="Hotel" name="group_hotel"
                        context="{'group_by': 'hotel_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_physical_rooms" model="ir.actions.act_window">
        <field name="name">Physical Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hotel_room_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your physical rooms here.
            </p>
            <p>
                Each record is one real room (e.g. 201, 202). Link it to a
                <strong>room type</strong> product (Garden View, Deluxe, etc.).
                Booking and allotment use <strong>Physical Rooms</strong> linked
                to each room type product.
            </p>
        </field>
    </record>

    <menuitem id="menu_hotel_physical_rooms"
        name="Physical Rooms"
        parent="hotel_management_system.menu_hotel_rooms"
        action="action_hotel_physical_rooms"
        sequence="5"
        groups="hotel_management_system.hotel_owner_group,hotel_management_system.hotel_reception_group"/>
</odoo>
