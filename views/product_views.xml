<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_day_long_tour_config" model="ir.ui.view">
        <field name="name">product.template.form.day.long.tour.config</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hotel_management_system.product_template_service_facility_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='room configuration']" position="after">
                <page string="Day-Long Tour" name="day_long_tour_config"
                    invisible="not is_day_long_tour">
                    <group>
                        <field name="day_tour_max_occupancy"/>
                    </group>
                    <div class="text-muted">
                        Total guests on folio lines reduce this tour's daily capacity
                        for the line check-in date at the selected hotel.
                        Deleting a tour line or cancelling a booking restores capacity.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_physical_rooms_button" model="ir.ui.view">
        <field name="name">product.template.form.physical.rooms.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_physical_rooms" type="object"
                    class="oe_stat_button" icon="fa-bed"
                    invisible="not is_room_type">
                    <field name="physical_room_count" widget="statinfo"
                        string="Physical Rooms"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_is_bookable" model="ir.ui.view">
        <field name="name">product.template.form.is.bookable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hotel_management_system.inherit_product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_room_type']/.." position="after">
                <span class="d-inline-block" invisible="is_room_type">
                    <field name="is_day_long_tour" invisible="not categ_id.is_bookable"/>
                    <label for="is_day_long_tour" invisible="not categ_id.is_bookable"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_room_inventory" model="ir.ui.view">
        <field name="name">product.template.form.room.inventory</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hotel_management_system.product_template_service_facility_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='room configuration']/group[field[@name='service_ids']]" position="before">
                <group string="Room Inventory">
                    <field name="room_count"/>
                    <field name="physical_room_count"/>
                    <field name="placeholder_variant_id"/>
                </group>
                <group string="Physical Rooms" invisible="not is_room_type">
                    <field name="physical_room_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="name" string="Room Number"/>
                            <field name="floor" optional="show"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_room_variant_warning" model="ir.ui.view">
        <field name="name">product.template.form.room.variant.warning</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']" position="before">
                <field name="room_count_mismatch_warning" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert"
                    invisible="not is_room_type or not room_count_mismatch_warning">
                    <field name="room_count_mismatch_warning" nolabel="1" readonly="1" class="mb-0"/>
                </div>
                <group invisible="not is_room_type" colspan="2">
                    <field name="room_count" readonly="1"/>
                    <field name="physical_room_count" string="Physical Rooms"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='room configuration']/group[field[@name='service_ids']]" position="before">
                <div class="alert alert-warning mb-3" role="alert"
                    invisible="not is_room_type or not room_count_mismatch_warning or product_variant_count &gt; 1">
                    <field name="room_count_mismatch_warning" nolabel="1" readonly="1" class="mb-0"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view_room_placeholder" model="ir.ui.view">
        <field name="name">product.product.form.room.placeholder</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="is_room_placeholder" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search_inherit_is_bookable" model="ir.ui.view">
        <field name="name">product.template.search.is.bookable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hotel_management_system.view_product_template_search_inherit_hotel"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_hotel']" position="after">
                <separator/>
                <filter string="Bookable category" name="categ_is_bookable"
                    domain="[('categ_id.is_bookable', '=', True)]"/>
                <filter string="Day-Long Tour" name="is_day_long_tour"
                    domain="[('is_day_long_tour', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
