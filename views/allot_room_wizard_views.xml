<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_booking_allot_room_wizard_form" model="ir.ui.view">
        <field name="name">hotel.booking.allot.room.wizard.form</field>
        <field name="model">hotel.booking.allot.room.wizard</field>
        <field name="arch" type="xml">
            <form string="Allot Room">
                <group>
                    <field name="booking_id" invisible="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="booking_line_id" column_invisible="True" force_save="1" readonly="1"/>
                        <field name="wizard_id" column_invisible="True" force_save="1"/>
                        <field name="room_type_id"/>
                        <field name="current_room_id" string="Current Room" readonly="1"/>
                        <field name="check_in" widget="datetime" readonly="1"/>
                        <field name="check_out" widget="datetime" readonly="1"/>
                        <field name="available_room_ids" column_invisible="True"/>
                        <field name="assigned_room_id" string="Room Number" required="1"
                            options="{'no_create': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Allot Room" type="object"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_booking_allot_room_wizard" model="ir.actions.act_window">
        <field name="name">Allot Room</field>
        <field name="res_model">hotel.booking.allot.room.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
