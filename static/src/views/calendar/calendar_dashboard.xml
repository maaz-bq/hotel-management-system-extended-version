<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hotel_management_system_extend.DashboardProductDropdownItems" owl="1">
        <li>
            <a t-attf-class="dropdown-item" t-att-data-id="0" t-on-click="fetchRoomTypeData">ALL</a>
        </li>
        <li><hr class="dropdown-divider"/></li>
        <t t-if="model.meta.productData.bookable_categories" t-foreach="model.meta.productData.bookable_categories" t-as="category" t-key="'cat-' + category['id']">
            <t t-if="category.products and category.products.length">
                <li class="dropdown-header text-muted"><t t-esc="category.name"/></li>
                <t t-foreach="category.products" t-as="room" t-key="'cat-' + category['id'] + '-' + room['id']">
                    <li>
                        <a t-attf-class="dropdown-item" t-att-data-id="room.id" t-on-click="fetchRoomTypeData">
                            <t t-esc="room.name"/>
                        </a>
                    </li>
                </t>
                <li><hr class="dropdown-divider"/></li>
            </t>
        </t>
    </t>

    <t t-name="hotel_management_system_extend.DashboardProductFilters" owl="1">
        <t t-if="model.meta.productData.bookable_categories" t-foreach="model.meta.productData.bookable_categories" t-as="category" t-key="'catf-' + category['id']">
            <t t-if="category.products" t-foreach="category.products" t-as="room" t-key="'catfp-' + category['id'] + '-' + room['id']">
                <div class="roomRowFilter">
                    <span>
                        <t t-set="room" t-value="room"/>
                        <t t-call="hotel_management_system.FilterBasedOnBooking.filter"/>
                    </span>
                </div>
            </t>
        </t>
    </t>

    <t t-name="hotel_management_system_extend.ExtendedDashboardDropdown" owl="1">
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Products
                (<t t-esc="model.meta.productData.bookable_categories.length"/> categories)
            </button>
            <ul class="dropdown-menu dropdown-menu-primary">
                <t t-call="hotel_management_system_extend.DashboardProductDropdownItems"/>
            </ul>
        </div>
        <div class="allBookingRoom d-none">
            <t t-call="hotel_management_system_extend.DashboardProductFilters"/>
        </div>
    </t>

    <t t-inherit="hotel_management_system.FilterBasedOnBooking" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('custom-grid')]" position="attributes">
            <attribute name="t-if">bookingModel() and !props.context.hotel_extended_calendar</attribute>
        </xpath>

        <xpath expr="//div[hasclass('available-portion')]" position="attributes">
            <attribute name="t-if">bookingModel() and !props.context.hotel_extended_calendar</attribute>
        </xpath>
        <xpath expr="//div[hasclass('booked-portion')]" position="attributes">
            <attribute name="t-if">bookingModel() and !props.context.hotel_extended_calendar</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_calendar_header')]//div[hasclass('roomCustomUI')]" position="attributes">
            <attribute name="t-if">bookingModel() and !props.context.hotel_extended_calendar and isMobileView()</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_calendar_wrapper')]//div[hasclass('roomCustomUI')]" position="attributes">
            <attribute name="t-if">bookingModel() and !props.context.hotel_extended_calendar and !isMobileView()</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_sidebar_toggler')]" position="attributes">
            <attribute name="t-if">!props.context.hotel_extended_calendar</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_calendar_sidebar_container')]" position="attributes">
            <attribute name="t-if">showSideBar and !props.context.hotel_extended_calendar</attribute>
        </xpath>
    </t>
</templates>
